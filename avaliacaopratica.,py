urgentes = 0
total_minutos = 0
maior_tempo = 0

for contador in range(1, 11):

    while True:
        prioridade = int(input(f"Pedido {contador} - Prioridade (1 a 5): "))

        if 1 <= prioridade <= 5:
            break

        print("Prioridade inválida.")

    while True:
        tempo = int(input("Tempo estimado (minutos): "))

        if tempo > 0:
            break

        print("Tempo inválido.")

    if prioridade <= 2:
        urgentes += 1

    total_minutos += tempo

    if tempo > maior_tempo:
        maior_tempo = tempo

media = total_minutos / 10

if urgentes >= 5 or total_minutos > 600:
    classificacao = "CRÍTICA"

elif urgentes >= 3 or total_minutos > 480:
    classificacao = "ELEVADA"

else:
    classificacao = "NORMAL"

print("\n===== RESULTADOS =====")
print("Pedidos urgentes:", urgentes)
print("Total minutos:", total_minutos)
print("Média:", media)
print("Maior tempo:", maior_tempo)
print("Classificação:", classificacao)
